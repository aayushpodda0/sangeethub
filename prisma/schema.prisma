generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum LanguageCode {
  HINDI
  MARATHI
  TAMIL
  TELUGU
  BENGALI
  MALAYALAM
  KANNADA
  PUNJABI
  ENGLISH
}

enum Mood {
  FOCUS
  WORKOUT
  RELAX
  TRAVEL
  PARTY
  SLEEP
  HAPPY
  SAD
  ENERGETIC
  CALM
}

enum Activity {
  STUDY
  GYM
  COMMUTE
  CODING
  YOGA
  RUNNING
  MEDITATION
  CELEBRATION
  SLEEPING
}

enum CollaborationPermission {
  CONTRIBUTOR
  MODERATOR
}

enum PlaylistActivityType {
  CREATED
  RENAMED
  TRACK_ADDED
  TRACK_REMOVED
  REORDERED
  COLLAB_ENABLED
  COLLAB_DISABLED
}

enum PartyParticipantRole {
  HOST
  GUEST
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}

model User {
  id                  String                  @id @default(cuid())
  name                String?
  username            String                  @unique
  email               String                  @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                Role                    @default(USER)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  accounts            Account[]
  sessions            Session[]
  playlistsOwned      Playlist[]              @relation("PlaylistOwner")
  playlistFolders     PlaylistFolder[]
  playlistTracksAdded PlaylistTrack[]
  favoriteTracks      FavoriteTrack[]
  savedAlbums         SavedAlbum[]
  followedArtists     FollowedArtist[]
  recentPlays         RecentlyPlayed[]
  recommendations     Recommendation[]
  collaborations      PlaylistCollaboration[]
  playlistActivities  PlaylistActivity[]
  playlistInvitesCreated PlaylistInvite[]
  partyRoomsHosted    PartyRoom[]             @relation("PartyRoomHost")
  partyParticipations PartyParticipant[]
  partyQueueItemsAdded PartyQueueItem[]
  queueVotes          QueueVote[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Artist {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  bio            String?
  city           String?
  region         String?
  imageUrl       String?
  isIndependent  Boolean          @default(true)
  popularity     Int              @default(50)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  albums         Album[]
  trackArtists   TrackArtist[]
  followers      FollowedArtist[]
  recentPlays    RecentlyPlayed[]
  recommendations Recommendation[]

  @@index([name])
  @@index([region, city])
}

model Album {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  description    String?
  releaseDate    DateTime
  artworkUrl     String?
  primaryArtistId String
  language       LanguageCode
  popularity     Int               @default(50)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  primaryArtist  Artist            @relation(fields: [primaryArtistId], references: [id], onDelete: Restrict)
  tracks         Track[]
  savedBy        SavedAlbum[]
  recentPlays    RecentlyPlayed[]

  @@index([title])
  @@index([primaryArtistId])
  @@index([language])
}

model Genre {
  id        String      @id @default(cuid())
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tracks    TrackGenre[]

  @@index([name])
}

model Track {
  id                 String            @id @default(cuid())
  title              String
  slug               String            @unique
  albumId            String
  durationSeconds    Int
  previewUrl         String
  artworkUrl         String?
  language           LanguageCode
  moods              Mood[]
  activities         Activity[]
  tempo              Int
  popularity         Int               @default(50)
  explicit           Boolean           @default(false)
  releaseDate        DateTime
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  album              Album             @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artists            TrackArtist[]
  genres             TrackGenre[]
  playlistEntries    PlaylistTrack[]
  favoritedBy        FavoriteTrack[]
  recentPlays        RecentlyPlayed[]
  recommendations    Recommendation[]
  partyQueueItems    PartyQueueItem[]
  currentInPartyRooms PartyRoom[]

  @@index([title])
  @@index([albumId])
  @@index([language])
  @@index([popularity])
}

model TrackArtist {
  trackId  String
  artistId String
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
  @@index([artistId])
}

model TrackGenre {
  trackId  String
  genreId  String
  track    Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre    Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId])
}

model PlaylistFolder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]

  @@unique([userId, name])
  @@index([userId])
}

model Playlist {
  id              String                  @id @default(cuid())
  ownerId         String
  folderId        String?
  name            String
  slug            String                  @unique
  description     String?
  coverUrl        String?
  isPublic        Boolean                 @default(false)
  isCollaborative Boolean                 @default(false)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  owner           User                    @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder          PlaylistFolder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tracks          PlaylistTrack[]
  tags            PlaylistTag[]
  collaborations  PlaylistCollaboration[]
  activities      PlaylistActivity[]
  invitations     PlaylistInvite[]
  recommendations Recommendation[]

  @@index([ownerId])
  @@index([folderId])
  @@index([isPublic, updatedAt])
}

model PlaylistTag {
  id        String   @id @default(cuid())
  playlistId String
  name      String
  playlist  Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, name])
  @@index([name])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  addedById  String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedBy    User     @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([playlistId, position])
  @@index([playlistId, trackId])
  @@index([addedById])
}

model FavoriteTrack {
  userId    String
  trackId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
  @@index([createdAt])
}

model SavedAlbum {
  userId    String
  albumId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
}

model FollowedArtist {
  userId    String
  artistId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

model RecentlyPlayed {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  artistId  String?
  albumId   String?
  playedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  album     Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)

  @@index([userId, playedAt])
}

model Recommendation {
  id             String   @id @default(cuid())
  userId         String
  trackId        String?
  artistId       String?
  playlistId     String?
  reasonCode     String
  reasonLabel    String
  explanation    String
  score          Float
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track          Track?   @relation(fields: [trackId], references: [id], onDelete: SetNull)
  artist         Artist?  @relation(fields: [artistId], references: [id], onDelete: SetNull)
  playlist       Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model PlaylistCollaboration {
  id               String                   @id @default(cuid())
  playlistId       String
  userId           String
  permission       CollaborationPermission  @default(CONTRIBUTOR)
  canRemoveOthers  Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  playlist         Playlist                 @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
  @@index([userId])
}

model PlaylistInvite {
  id          String   @id @default(cuid())
  playlistId  String
  token       String   @unique
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([playlistId])
}

model PlaylistActivity {
  id         String               @id @default(cuid())
  playlistId String
  actorId    String
  type       PlaylistActivityType
  message    String
  createdAt  DateTime             @default(now())
  playlist   Playlist             @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([playlistId, createdAt])
}

model PartyRoom {
  id               String             @id @default(cuid())
  roomCode         String             @unique
  hostId           String
  name             String
  isActive         Boolean            @default(true)
  currentTrackId   String?
  startedAt        DateTime?
  playbackPosition Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  host             User               @relation("PartyRoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  currentTrack     Track?             @relation(fields: [currentTrackId], references: [id], onDelete: SetNull)
  participants     PartyParticipant[]
  queueItems       PartyQueueItem[]

  @@index([hostId])
  @@index([isActive, updatedAt])
}

model PartyParticipant {
  id          String               @id @default(cuid())
  roomId       String
  userId       String
  role         PartyParticipantRole @default(GUEST)
  connectedAt  DateTime             @default(now())
  disconnectedAt DateTime?
  room         PartyRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model PartyQueueItem {
  id          String      @id @default(cuid())
  roomId      String
  trackId     String
  addedById   String
  position    Int
  voteScore   Int         @default(0)
  createdAt   DateTime    @default(now())
  room        PartyRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  track       Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  addedBy     User        @relation(fields: [addedById], references: [id], onDelete: Cascade)
  votes       QueueVote[]

  @@unique([roomId, position])
  @@index([roomId, voteScore])
}

model QueueVote {
  id            String    @id @default(cuid())
  queueItemId   String
  userId        String
  voteType      VoteType
  createdAt     DateTime  @default(now())
  queueItem     PartyQueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, userId])
  @@index([userId, createdAt])
}
