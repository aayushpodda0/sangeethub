# --- Required ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sangeethub?schema=public"
# Generate with: openssl rand -base64 32   (the app refuses to start in production with a placeholder/short secret)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Must match the URL users actually visit (https://... in production)
NEXTAUTH_URL="http://localhost:3000"

# --- Optional ---
# Passwords for seeded accounts. Both are required when running the seed.
# SEED_ADMIN_PASSWORD=""
# SEED_LISTENER_PASSWORD=""
# PORT=3000
# APP_HOSTNAME=localhost
